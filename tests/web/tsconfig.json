{
  "extends": "../../tooling/tsconfig/web.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "app/*": ["../../apps/web/app/*"],
      "components/*": ["../../apps/web/components/*"],
      "lib/*": ["../../apps/web/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
