# Local Worker secrets for `wrangler dev` / `opennextjs-cloudflare preview`.
# Copy to .dev.vars (git-ignored). In stage/prod these are Worker secrets, set
# once per environment with `wrangler secret put <NAME> --name commerce-web-<env>`
# (README → Deploying); the deploy lane does not set them. Left unset, the
# storefront renders without products ("Shopify not configured"), as upstream
# does before its integration is connected.
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_REVALIDATION_SECRET=""
# Which Next .env files the Worker loads at start (defaults to production).
# NEXTJS_ENV=development
