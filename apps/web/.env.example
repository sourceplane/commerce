# Local development (`pnpm --filter @app/web dev`). Copy to .env.local
# (git-ignored). The Worker reads COMPANY_NAME, SITE_NAME and SITE_URL as
# wrangler vars (wrangler.template.jsonc) and the SHOPIFY_* values as Worker
# secrets (.dev.vars.example).
COMPANY_NAME="Vercel Inc."
SITE_NAME="Next.js Commerce"
SITE_URL="http://localhost:3000"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
