# Local development. Every value is optional: with no Shopify store the
# storefront serves its bundled demo catalogue (lib/demo) and keeps the cart
# in a cookie. The store's name is apps/web/app/site.ts, and its origin is
# the request's own.
#
#   Next's dev server (`pnpm dev`)              → copy to .env.local
#   the Worker preview (`pnpm preview`)         → copy to .dev.vars
#
# Both are git-ignored. On the deployed Workers the SHOPIFY_* values are
# Worker secrets, set once per environment with
# `wrangler secret put <NAME> --name commerce-web-<env>` (the repository's
# README, "Connecting Shopify"); the deploy lane never sets them.
COMPANY_NAME=""
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_REVALIDATION_SECRET=""
